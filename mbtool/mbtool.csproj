<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>mbtool</AssemblyName>
    <RootNamespace>MbTool</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>CS0618;CS0169;CS0649;CS0414;CS8981;CS0219;CS0162;CS0108;CS0672;CS1030</NoWarn>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Compile Include="..\TpacTool-master\TpacTool.Lib\**\*.cs"
             Exclude="..\TpacTool-master\TpacTool.Lib\Thirdparty\System.Numerics.Vector\**\*.cs" />
  </ItemGroup>

</Project>
